[Unit]
Description=MackNa Gate - bounded read-only Docker API
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=mackna-gate
Group=mackna-gate
SupplementaryGroups=docker mackna
Environment=MACKNA_DOCKER_SOCKET=/var/run/docker.sock
Environment=MACKNA_GATE_LISTEN=/run/mackna-gate/docker-ro.sock
Environment=MACKNA_GATE_CLIENT_GROUP=mackna
ExecStart=/usr/local/bin/mackna-gate
RuntimeDirectory=mackna-gate
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
MemoryMax=96M
TasksMax=64

[Install]
WantedBy=multi-user.target
